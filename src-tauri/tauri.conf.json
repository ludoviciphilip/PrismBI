{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VetroBI",
  "version": "0.11.0",
  "identifier": "dev.vetrobi.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VetroBI",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 https: http:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "conflicts": ["prismbi"],
        "replaces": ["prismbi"],
        "provides": ["prismbi"]
      },
      "rpm": {
        "conflicts": ["prismbi"],
        "obsoletes": ["prismbi"],
        "provides": ["prismbi"]
      }
    },
    "windows": {
      "wix": {
        "language": "pt-BR",
        "upgradeCode": "6f4d6c9a-9e3b-4b7a-9c2d-2a9f0b7c5d6e"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
