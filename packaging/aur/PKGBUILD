# Maintainer: Luis Felipe de Almeida Vieira
#
# Usa o binário do .deb oficial ligado ao webkit2gtk-4.1 do sistema, em vez
# de reempacotar o AppImage: o WebKitGTK embutido no AppImage (Ubuntu 22.04)
# é antigo e deixa o canvas visivelmente mais lento em distros atuais.
# Atualize pkgver/sha256sums com scripts/update-aur-pkgbuild.sh <versão>.
pkgname=vetrobi-bin
pkgver=0.11.0
pkgrel=1
pkgdesc="Open-source Power BI alternative: native BI desktop app that opens .pbip/.pbix, with a Rust DAX engine, Power Query editor and DuckDB"
arch=('x86_64')
url="https://github.com/ludoviciphilip/VetroBI"
license=("LicenseRef-Mutualist-1.3")
depends=('webkit2gtk-4.1' 'gtk3' 'libsecret' 'hicolor-icon-theme')
provides=('vetrobi')
conflicts=('vetrobi' 'prismbi' 'prismbi-bin')
replaces=('prismbi-bin')
options=('!strip' '!debug')
_deb="VetroBI_${pkgver}_amd64.deb"
source=("${_deb}::${url}/releases/download/v${pkgver}/${_deb}"
        "LICENSE.md::https://raw.githubusercontent.com/ludoviciphilip/VetroBI/v${pkgver}/LICENSE.md")
sha256sums=('ef132df9c97e9f77e5747fb71b29dca4994a18c51fc6d74030678f5ac0a95689'
            '82c96d8e5199361f90098229b3374d96666c3edb17fcc74e9a6e81859dd428ef')
noextract=("${_deb}")

package() {
  cd "${srcdir}"
  bsdtar -xf "${_deb}" data.tar.gz
  bsdtar -xf data.tar.gz -C "${pkgdir}"
  chmod 755 "${pkgdir}/usr/bin/vetrobi"
  find "${pkgdir}/usr/share" -type d -exec chmod 755 {} +
  find "${pkgdir}/usr/share" -type f -exec chmod 644 {} +
  install -Dm644 "${srcdir}/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
}
