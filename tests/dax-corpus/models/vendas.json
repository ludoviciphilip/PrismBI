{
  "description": "Modelo estrela pequeno e verificável à mão: 12 vendas em 2024–2025, 4 produtos, 3 clientes e calendário diário gerado. Compartilhado pelos arquivos de casos.",
  "tables": [
    {
      "name": "d_Produto",
      "columns": [
        { "name": "ProdutoID", "type": "number" },
        { "name": "Produto", "type": "text" },
        { "name": "Categoria", "type": "text" },
        { "name": "Preco", "type": "number" }
      ],
      "rows": [
        [1, "Caneta", "Papelaria", 2.5],
        [2, "Caderno", "Papelaria", 12],
        [3, "Mouse", "Informatica", 80],
        [4, "Teclado", "Informatica", 150]
      ]
    },
    {
      "name": "d_Cliente",
      "columns": [
        { "name": "ClienteID", "type": "number" },
        { "name": "Cliente", "type": "text" },
        { "name": "Cidade", "type": "text" }
      ],
      "rows": [
        [1, "Ana", "Curitiba"],
        [2, "Bruno", "Londrina"],
        [3, "Carla", "Curitiba"]
      ]
    },
    {
      "name": "d_Calendario",
      "calendar": { "start": "2024-01-01", "end": "2025-12-31" },
      "columns": [
        { "name": "Data", "type": "date" },
        { "name": "Ano", "type": "number" },
        { "name": "MesNum", "type": "number" },
        { "name": "Trimestre", "type": "number" },
        { "name": "AnoMes", "type": "text" }
      ]
    },
    {
      "name": "f_Vendas",
      "columns": [
        { "name": "VendaID", "type": "number" },
        { "name": "Data", "type": "date" },
        { "name": "ProdutoID", "type": "number" },
        { "name": "ClienteID", "type": "number" },
        { "name": "Qtd", "type": "number" },
        { "name": "Valor", "type": "number" },
        { "name": "Desconto", "type": "number" }
      ],
      "rows": [
        [1, "2024-01-15", 1, 1, 10, 25, null],
        [2, "2024-01-20", 3, 2, 1, 80, 5],
        [3, "2024-02-10", 2, 1, 3, 36, null],
        [4, "2024-03-05", 4, 3, 1, 150, 10],
        [5, "2024-03-28", 1, 2, 20, 50, null],
        [6, "2024-06-30", 3, 3, 2, 160, 0],
        [7, "2024-12-31", 2, 2, 5, 60, null],
        [8, "2025-01-10", 1, 1, 8, 20, null],
        [9, "2025-01-31", 4, 1, 2, 300, 20],
        [10, "2025-02-14", 3, 3, 1, 80, null],
        [11, "2025-03-01", 2, 2, 2, 24, 2],
        [12, "2025-03-31", 4, 3, 1, 150, null]
      ]
    }
  ],
  "relationships": [
    { "from": "f_Vendas[ProdutoID]", "to": "d_Produto[ProdutoID]", "crossFilter": "single", "active": true },
    { "from": "f_Vendas[ClienteID]", "to": "d_Cliente[ClienteID]", "crossFilter": "single", "active": true },
    { "from": "f_Vendas[Data]", "to": "d_Calendario[Data]", "crossFilter": "single", "active": true }
  ],
  "measures": [
    { "table": "f_Vendas", "name": "Total Vendas", "formula": "SUM(f_Vendas[Valor])" },
    { "table": "f_Vendas", "name": "Qtd Total", "formula": "SUM(f_Vendas[Qtd])" },
    { "table": "f_Vendas", "name": "Num Vendas", "formula": "COUNTROWS(f_Vendas)" },
    { "table": "f_Vendas", "name": "Ticket Medio", "formula": "DIVIDE([Total Vendas], [Num Vendas])" }
  ]
}
