{
  "allSteps": {
    "name": "Contrato",
    "source": {
      "kind": "inline",
      "columns": [
        "Produto",
        "Cidade",
        "Valor",
        "Qtd",
        "Cod"
      ],
      "rows": [
        [
          "caneta azul",
          "Curitiba",
          10.5,
          2,
          "A-1"
        ],
        [
          "lápis",
          null,
          3,
          1,
          "B-2"
        ],
        [
          "caneta azul",
          "Curitiba",
          10.5,
          2,
          "A-1"
        ],
        [
          "borracha",
          "Londrina",
          1.25,
          4,
          "C-3"
        ]
      ]
    },
    "steps": [
      {
        "id": "s1",
        "name": "Tipo Alterado",
        "op": "changeType",
        "columns": [
          {
            "column": "Valor",
            "type": "decimal"
          },
          {
            "column": "Qtd",
            "type": "integer"
          }
        ]
      },
      {
        "id": "s2",
        "name": "Duplicatas Removidas",
        "op": "removeDuplicates"
      },
      {
        "id": "s3",
        "name": "Preenchido Abaixo",
        "op": "fillDown",
        "columns": [
          "Cidade"
        ]
      },
      {
        "id": "s4",
        "name": "Preenchido Acima",
        "op": "fillUp",
        "columns": [
          "Cidade"
        ]
      },
      {
        "id": "s5",
        "name": "Valor Substituído",
        "op": "replaceValues",
        "columns": [
          "Produto"
        ],
        "find": "azul",
        "replace": "preta",
        "matchEntireCell": false
      },
      {
        "id": "s6",
        "name": "Texto Maiúsculo",
        "op": "textTransform",
        "columns": [
          "Cidade"
        ],
        "fn": "upper"
      },
      {
        "id": "s7",
        "name": "Coluna Dividida",
        "op": "splitColumn",
        "column": "Cod",
        "mode": "delimiterEach",
        "delimiter": "-",
        "into": [
          "Cod.1",
          "Cod.2"
        ]
      },
      {
        "id": "s8",
        "name": "Colunas Mescladas",
        "op": "mergeColumns",
        "columns": [
          "Cod.1",
          "Cod.2"
        ],
        "separator": "/",
        "newColumn": "Código"
      },
      {
        "id": "s9",
        "name": "Coluna Duplicada",
        "op": "duplicateColumn",
        "column": "Valor",
        "newColumn": "Valor - Cópia"
      },
      {
        "id": "s10",
        "name": "Colunas Renomeadas",
        "op": "renameColumns",
        "renames": [
          [
            "Valor - Cópia",
            "Preço"
          ]
        ]
      },
      {
        "id": "s11",
        "name": "Coluna Condicional",
        "op": "addConditionalColumn",
        "newColumn": "Faixa",
        "rules": [
          {
            "when": {
              "column": "Valor",
              "op": "gte",
              "value": 10
            },
            "then": "Alta"
          }
        ],
        "otherwise": "Baixa",
        "type": "text"
      },
      {
        "id": "s12",
        "name": "Total",
        "op": "addCustomColumn",
        "newColumn": "Total",
        "expression": "[Valor] * [Qtd]",
        "type": "decimal"
      },
      {
        "id": "s13",
        "name": "Índice",
        "op": "addIndexColumn",
        "newColumn": "Índice",
        "start": 1,
        "step": 1
      },
      {
        "id": "s14",
        "name": "Linhas Filtradas",
        "op": "filterRows",
        "condition": {
          "and": [
            {
              "column": "Cidade",
              "op": "isNotNull"
            },
            {
              "not": {
                "column": "Produto",
                "op": "in",
                "values": [
                  "x",
                  "y"
                ]
              }
            }
          ]
        }
      },
      {
        "id": "s15",
        "name": "Linhas Classificadas",
        "op": "sort",
        "by": [
          {
            "column": "Total",
            "descending": true
          }
        ]
      },
      {
        "id": "s16",
        "name": "Primeiras Linhas",
        "op": "keepTopRows",
        "count": 10
      },
      {
        "id": "s17",
        "name": "Linhas Superiores Removidas",
        "op": "removeTopRows",
        "count": 0
      },
      {
        "id": "s18",
        "name": "Últimas Linhas",
        "op": "keepBottomRows",
        "count": 10
      },
      {
        "id": "s19",
        "name": "Linhas Inferiores Removidas",
        "op": "removeBottomRows",
        "count": 0
      },
      {
        "id": "s20",
        "name": "Linhas em Branco Removidas",
        "op": "removeBlankRows"
      },
      {
        "id": "s21",
        "name": "Erros Removidos",
        "op": "removeRowsWithErrors"
      },
      {
        "id": "s22",
        "name": "Outras Colunas Removidas",
        "op": "selectColumns",
        "columns": [
          "Produto",
          "Cidade",
          "Valor",
          "Qtd",
          "Total",
          "Faixa",
          "Preço",
          "Código"
        ]
      },
      {
        "id": "s23",
        "name": "Colunas Removidas",
        "op": "removeColumns",
        "columns": [
          "Código"
        ]
      },
      {
        "id": "s24",
        "name": "Linhas Agrupadas",
        "op": "groupBy",
        "keys": [
          "Cidade"
        ],
        "aggregations": [
          {
            "name": "Soma",
            "op": "sum",
            "column": "Total"
          },
          {
            "name": "Linhas",
            "op": "countRows"
          }
        ]
      },
      {
        "id": "s25",
        "name": "Linhas Invertidas",
        "op": "reverseRows"
      },
      {
        "id": "s26",
        "name": "Colunas Reordenadas",
        "op": "reorderColumns",
        "columns": [
          "Linhas",
          "Cidade",
          "Soma"
        ]
      },
      {
        "id": "s27",
        "name": "Cidade Abreviada",
        "op": "transformColumns",
        "columns": [
          "Cidade"
        ],
        "expression": "Text.Start(_, 3)",
        "type": "text"
      },
      {
        "id": "s28",
        "name": "Intervalo Mantido",
        "op": "keepRange",
        "offset": 0,
        "count": 2
      },
      {
        "id": "s29",
        "name": "Linhas Alternadas Removidas",
        "op": "removeAlternateRows",
        "offset": 0,
        "remove": 1,
        "keep": 1
      },
      {
        "id": "s30",
        "name": "Duplicatas Mantidas",
        "op": "keepDuplicates",
        "columns": [
          "Cidade"
        ]
      },
      {
        "id": "s31",
        "name": "Erros Substituídos",
        "op": "replaceErrors",
        "replacements": [
          {
            "column": "Soma",
            "value": 0
          }
        ]
      },
      {
        "id": "s32",
        "name": "Linhas Com Erros Mantidas",
        "op": "keepRowsWithErrors"
      }
    ]
  },
  "shapeSteps": {
    "name": "ContratoFormato",
    "source": {
      "kind": "table",
      "table": "Outra"
    },
    "steps": [
      {
        "id": "p0",
        "name": "Cabeçalhos Promovidos",
        "op": "promoteHeaders"
      },
      {
        "id": "p1",
        "name": "Pivot",
        "op": "pivot",
        "column": "Mês",
        "valuesColumn": "Valor",
        "aggregation": "sum"
      },
      {
        "id": "p2",
        "name": "Unpivot Outras",
        "op": "unpivotOtherColumns",
        "keep": [
          "Cidade"
        ],
        "attributeColumn": "Atributo",
        "valueColumn": "Valor"
      },
      {
        "id": "p3",
        "name": "Unpivot",
        "op": "unpivotColumns",
        "columns": [
          "Jan",
          "Fev"
        ],
        "attributeColumn": "Mês",
        "valueColumn": "Valor"
      },
      {
        "id": "p4",
        "name": "Consultas Mescladas",
        "op": "mergeQueries",
        "rightQuery": "dCidades",
        "leftKeys": [
          "Cidade"
        ],
        "rightKeys": [
          "Nome"
        ],
        "joinKind": "leftOuter",
        "expand": [
          {
            "column": "UF",
            "as": "UF"
          }
        ]
      },
      {
        "id": "p5",
        "name": "Consultas Acrescentadas",
        "op": "appendQueries",
        "queries": [
          "Vendas2025"
        ]
      },
      {
        "id": "p6",
        "name": "Cabeçalhos Rebaixados",
        "op": "demoteHeaders"
      },
      {
        "id": "p7",
        "name": "Tabela Transposta",
        "op": "transpose"
      }
    ]
  }
}
